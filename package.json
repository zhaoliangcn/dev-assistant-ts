{
  "name": "dev-assistant-ts",
  "version": "0.1.0",
  "description": "纯 Node.js/TypeScript 实现的 AI 编程代理框架（dev-assistant-rs 的 Node.js 重写版）",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/main.js"
    },
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "default": "./dist/embed/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dev-assistant": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepare": "npm run build",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "graceful-fs": "^4.2.11",
    "marked": "^18.0.14",
    "picomatch": "^4.0.7",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "shiki": "^4.4.3",
    "smol-toml": "^1.9.0",
    "undici": "^8.11.2",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  }
}
